{
  "expo": {
    "name": "RMM Phone Agent",
    "slug": "rmm-phone-agent",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": ["fetch"]
      }
    },
    "android": {
      "package": "com.fixsmith.rmm.phoneagent"
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
